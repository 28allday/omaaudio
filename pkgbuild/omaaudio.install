_omaaudio_update_desktop() {
  gtk-update-icon-cache -q -t -f usr/share/icons/hicolor >/dev/null 2>&1 || true
  update-desktop-database -q >/dev/null 2>&1 || true
}

post_install() {
  _omaaudio_update_desktop
  echo 'Agent skill included. Run as your user: omaaudio skill --link'
  echo 'The source bin/install command does this automatically.'
}

post_upgrade() { post_install; }

post_remove() {
  _omaaudio_update_desktop
}
