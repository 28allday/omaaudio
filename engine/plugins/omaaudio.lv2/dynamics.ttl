@prefix lv2: <http://lv2plug.in/ns/lv2core#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<urn:omaaudio:limit>
    a lv2:Plugin, lv2:LimiterPlugin ;
    doap:name "OmaAudio Limit Peaks" ;
    doap:license <https://opensource.org/licenses/MIT> ;
    doap:maintainer [ foaf:name "OmaAudio" ] ;
    rdfs:comment "Keeps every peak at or under the ceiling. It looks 5 ms ahead, so the level eases down before a peak instead of clipping it; both sides of a stereo track move together. Below the ceiling the sound is untouched." ;
    lv2:optionalFeature lv2:hardRTCapable ;
    lv2:port [
        a lv2:InputPort, lv2:AudioPort ; lv2:index 0 ; lv2:symbol "in_l" ; lv2:name "Left input"
    ] , [
        a lv2:InputPort, lv2:AudioPort ; lv2:index 1 ; lv2:symbol "in_r" ; lv2:name "Right input" ;
        lv2:portProperty lv2:connectionOptional
    ] , [
        a lv2:OutputPort, lv2:AudioPort ; lv2:index 2 ; lv2:symbol "out_l" ; lv2:name "Left output"
    ] , [
        a lv2:OutputPort, lv2:AudioPort ; lv2:index 3 ; lv2:symbol "out_r" ; lv2:name "Right output" ;
        lv2:portProperty lv2:connectionOptional
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 4 ; lv2:symbol "ceiling" ; lv2:name "Ceiling" ;
        lv2:minimum -24 ; lv2:maximum 0 ; lv2:default -1 ; units:unit units:db
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 5 ; lv2:symbol "release" ; lv2:name "Release" ;
        lv2:minimum 10 ; lv2:maximum 1000 ; lv2:default 100 ; units:unit units:ms ;
        lv2:portProperty <http://lv2plug.in/ns/ext/port-props#logarithmic>
    ] , [
        a lv2:OutputPort, lv2:ControlPort ; lv2:index 6 ; lv2:symbol "reduction" ; lv2:name "Gain reduction" ;
        lv2:minimum 0 ; lv2:maximum 60 ; lv2:default 0 ; units:unit units:db
    ] , [
        a lv2:OutputPort, lv2:ControlPort ; lv2:index 7 ; lv2:symbol "latency" ; lv2:name "Latency" ;
        lv2:minimum 0 ; lv2:maximum 7680 ; lv2:default 240 ;
        lv2:designation lv2:latency ; lv2:portProperty lv2:reportsLatency, lv2:integer ; units:unit units:frame
    ] .

<urn:omaaudio:gain>
    a lv2:Plugin, lv2:AmplifierPlugin ;
    doap:name "OmaAudio Change Level" ;
    doap:license <https://opensource.org/licenses/MIT> ;
    doap:maintainer [ foaf:name "OmaAudio" ] ;
    rdfs:comment "Makes the sound louder or quieter by a set number of decibels. Changes glide over a few milliseconds, so they never click." ;
    lv2:optionalFeature lv2:hardRTCapable ;
    lv2:port [
        a lv2:InputPort, lv2:AudioPort ; lv2:index 0 ; lv2:symbol "in_l" ; lv2:name "Left input"
    ] , [
        a lv2:InputPort, lv2:AudioPort ; lv2:index 1 ; lv2:symbol "in_r" ; lv2:name "Right input" ;
        lv2:portProperty lv2:connectionOptional
    ] , [
        a lv2:OutputPort, lv2:AudioPort ; lv2:index 2 ; lv2:symbol "out_l" ; lv2:name "Left output"
    ] , [
        a lv2:OutputPort, lv2:AudioPort ; lv2:index 3 ; lv2:symbol "out_r" ; lv2:name "Right output" ;
        lv2:portProperty lv2:connectionOptional
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 4 ; lv2:symbol "gain" ; lv2:name "Gain" ;
        lv2:minimum -48 ; lv2:maximum 24 ; lv2:default 0 ; units:unit units:db
    ] .
