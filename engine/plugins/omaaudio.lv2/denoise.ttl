@prefix lv2: <http://lv2plug.in/ns/lv2core#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<urn:omaaudio:denoise>
    a lv2:Plugin, lv2:UtilityPlugin ;
    doap:name "OmaAudio Voice Cleanup" ;
    doap:license <https://opensource.org/licenses/MIT> ;
    doap:maintainer [ foaf:name "OmaAudio" ] ;
    rdfs:comment "Reduces background noise in speech with the RNNoise voice model, live. 48 kHz only." ;
    lv2:optionalFeature lv2:hardRTCapable ;
    lv2:port [
        a lv2:InputPort, lv2:AudioPort ; lv2:index 0 ; lv2:symbol "in" ; lv2:name "Input"
    ] , [
        a lv2:OutputPort, lv2:AudioPort ; lv2:index 1 ; lv2:symbol "out" ; lv2:name "Output"
    ] , [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 2 ; lv2:symbol "amount" ; lv2:name "Amount" ;
        lv2:minimum 0 ; lv2:maximum 100 ; lv2:default 100 ; units:unit units:pc
    ] , [
        a lv2:OutputPort, lv2:ControlPort ; lv2:index 3 ; lv2:symbol "latency" ; lv2:name "Latency" ;
        lv2:minimum 0 ; lv2:maximum 1440 ; lv2:default 1440 ;
        lv2:designation lv2:latency ; lv2:portProperty lv2:reportsLatency, lv2:integer ; units:unit units:frame
    ] .
